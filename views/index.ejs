<!DOCTYPE html>
<html lang="en">

<head>
  <base href="<%= process.env.PUBLIC_URL || '/' %>">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Safety Dashboard</title>

  <!-- CSS -->
  <link rel="stylesheet" href="themes/default.css">


  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
  <!-- <script src="/js/chart.js" defer></script> -->

  <script>
    //Grab the constants sent on page load
    window.CONSTANTS = <%- JSON.stringify(constants) %>;
    window.USER_PERMISSIONS = <%- JSON.stringify(permissions || []) %>;
  </script>

  <!-- Chart Scripts -->
  <script src="js/charts/chartUtils.js" defer></script>
  <script src="js/charts/chartDataManager.js" defer></script>
  <script src="js/charts/chartRenderer.js" defer></script>
  <script src="js/charts/chartAdmin.js" defer></script>


  <script src="js/controlPanel.js" defer></script>
  <script src="https://kit.fontawesome.com/dd0a7425a6.js" crossorigin="anonymous"></script>
  <script src="js/notifications.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

</head>

<body>

  <%- include('components/header') %>

  <%- include('components/nav') %>

  <main class="content">
    <!-- Charts -->
    <div class="controls-panel">
      <h2>Dashboard Controls</h2>

      <%- include('components/controlPanel') %>

    </div>

    <!-- Charts -->
    <div class="charts-container" id="static-charts-container">
    </div>

    <div class="charts-container" id="dynamic-charts-container">
    </div>
  </main>
</body>

</html>