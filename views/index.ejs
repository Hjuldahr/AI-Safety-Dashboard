<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script type="module" src="/js/data_generator_v3.js" defer></script>
    <script type="module" src="/js/chart.js" defer></script>
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/fullSite.css">

</head>

<body>
    <%- include('components/header') %>

    <%- include('components/nav') %>

    <main class="content">
        <%- include('components/notifications') %>
        <!-- Charts -->
        <div style="width:100%; max-width:450px; position: relative;" class="chart-row">
            <canvas id="responseTimeChart"></canvas>
            <canvas id="energyConsumptionChart"></canvas>
        </div>

        <div style="width:100%; max-width:450px; position: relative;" class="chart-row">
            <canvas id="complianceChart"></canvas>
            <canvas id="helpfulnessChart"></canvas>
        </div>

        <button id="refresh-button">Refresh</button>

        <select id="model-select">
            <option value="good">Good Model</option>
            <option value="bad">Bad Model</option>
        </select>

    </main>
</body>

</html>