<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Demo [<%= currentModel %>] <%= currentScenario %> </title>

    <!-- CSS -->
    <link rel="stylesheet" href="css/themes/colors-default.css">
    <link rel="stylesheet" id="theme-colors" href="">
    <link rel="stylesheet" id="theme-layout" href="css/layouts/default.css">
    <link rel="stylesheet" href="css/components/notifications.css">
    <link rel="stylesheet" href="css/pages/demo.css">
    
    <!-- Scripts -->
    <script src="/js/demo.js"></script>
    <script src="https://kit.fontawesome.com/dd0a7425a6.js" crossorigin="anonymous"></script>
    <script src="/js/notifications.js" defer></script>
</head>
<body class="demo-page">
    <%- include('components/header') %>
    <%- include('components/nav') %>

    <main class="content">
        <div class="main-container">
            <div class="container">
                <h1>Model Demo Controller</h1>
                
                <label for="modelSelect">Select Model:</label>
                <select id="modelSelect">
                    <% models.forEach(function(model) { %>
                        <option value="<%= model %>" <%= (model === currentModel) ? "selected" : "" %>><%= model %></option>
                    <% }); %>
                </select>
                <br><br>
                <label for="scenarioSelect">Select Scenario:</label>
                <select id="scenarioSelect">
                    <% scenarios.forEach(function(scenario) { %>
                        <option value="<%= scenario %>" <%= (scenario === currentScenario) ? "selected" : "" %>><%= scenario %></option>
                    <% }); %>
                </select>
                <br><br>
                <div class="btn-group">
                    <button class="btn-apply">Apply Scenario</button>
                    <button class="btn-reset">Reset To Normal</button>
                </div>
            
                <div id="status"></div>
            </div>
        </div>
    </main>
</body>
</html>
