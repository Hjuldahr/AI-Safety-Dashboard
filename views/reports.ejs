<!DOCTYPE html>
<html lang="en">

<head>
  <base href="<%= process.env.PUBLIC_URL || '/' %>">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports</title>

  <!-- CSS -->
  <link rel="stylesheet" href="css/fullSite.css">
  <link rel="stylesheet" href="css/motd.css">
  <link rel="stylesheet" href="css/header.css">
  <link rel="stylesheet" href="css/nav.css">
  <link rel="stylesheet" href="css/notifications.css">

  <!-- Scripts -->
  <script src="https://kit.fontawesome.com/dd0a7425a6.js" crossorigin="anonymous"></script>
  <script src="js/notifications.js" defer></script>
  <script src="js/reports.js" defer></script>

  <script src="js/motd.js" defer></script>
</head>

<body>
  <%- include('components/motd') %>
  <%- include('components/header') %>
  <%- include('components/nav') %>

  <main class="content">

    <!-- NOTE: IDs & names tuned to match public/js/reports.js -->
    <form id="report-form" style="max-width: 700px; margin: 0 auto 24px;">
      <h2>Generate a Report</h2>

      <label for="reportTitle">Report Title</label>
      <input 
          type="text" 
          id="reportTitle" 
          name="reportTitle" 
          placeholder="e.g. Monthly Performance Overview"
          required
          style="width: 100%; padding: 8px; margin-bottom: 12px;"
      />

      <label for="startDate">Start Date</label>
      <input 
          type="date" 
          id="startDate" 
          name="startDate"
          required
          style="width: 100%; padding: 8px; margin-bottom: 12px;"
      />

      <label for="endDate">End Date</label>
      <input 
          type="date" 
          id="endDate" 
          name="endDate"
          required
          style="width: 100%; padding: 8px; margin-bottom: 12px;"
      />

      <label for="modelName">Model</label>
      <select
          id="modelName" 
          name="modelName"
          style="width: 100%; padding: 8px; margin-bottom: 12px;"
      >
          <option value="GoodModel">Good Model</option>
          <option value="BadModel">Bad Model</option>
      </select>

      <div style="display:flex; gap:12px;">
        <button 
            id="report-submit"
            type="submit"
            style="flex:1; padding: 10px; background: #4a79e0; color: white; border: none; cursor: pointer;"
        >
            Generate Report
        </button>

        <button
            id="report-download"
            type="button"
            style="flex:1; padding: 10px; background: #2c6f2c; color: white; border: none; cursor: pointer;"
        >
            Download PDF
        </button>

        <button
            id="report-download-csv"
            type="button"
            style="flex:1; padding: 10px; background: #6b7280; color: white; border: none; cursor: pointer;"
        >
            Download CSV
        </button>

        <button
            id="report-download-csv-aggregates"
            type="button"
            style="flex:1; padding: 10px; background: #5a57a9; color: white; border: none; cursor: pointer;"
        >
            Download Aggregates CSV
        </button>
      </div>
    </form>

    <p id="report-status" style="text-align:center; color:#666;"></p>

    <!-- Inline preview: hidden until a PDF is generated -->
    <div id="report-preview-wrapper" style="max-width:900px; margin: 16px auto; display:none;">
      <iframe id="report-preview" style="width:100%; height:800px; border:1px solid #ddd;"></iframe>
    </div>

  </main>

</body>

</html>
