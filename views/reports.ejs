<!DOCTYPE html>
<html lang="en">

<head>
  <base href="<%= process.env.PUBLIC_URL || '/' %>">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports</title>

  <!-- CSS -->
  <link rel="stylesheet" href="css/themes/colors-default.css">
  <link rel="stylesheet" id="theme-colors" href="">
  <link rel="stylesheet" id="theme-layout" href="css/layouts/default.css">
  <link rel="stylesheet" href="css/components/notifications.css">
  <link rel="stylesheet" href="css/pages/reports.css">
  

  <!-- Scripts -->
  <script src="https://kit.fontawesome.com/dd0a7425a6.js" crossorigin="anonymous"></script>
  <script src="js/notifications.js" defer></script>
  <script src="js/reports.js" defer></script>
</head>

<body>

  <%- include('components/header') %>
  <%- include('components/nav') %>

  <main class="content">
    <div class="reports-container card">
      <header class="report-header">
        <h1><i class="fa-solid fa-chart-line"></i> Report Generator</h1>
        <p>Configure and export custom model performance data.</p>
      </header>

      <form id="report-form">
        <section class="card">
          <h3>General Configuration</h3>
          <div class="input-grid">
            <div class="field-group">
              <label for="reportTitle">Report Title</label>
              <input type="text" id="reportTitle" name="reportTitle" placeholder="e.g. Monthly Performance Overview" required />
            </div>
            <div class="field-group">
              <label for="modelName">Target Model</label>
              <select id="modelName" name="modelName">
                <option value="GoodModel">Good Model</option>
                <option value="BadModel">Bad Model</option>
              </select>
            </div>
            <div class="field-group">
              <label for="startDate">Start Date</label>
              <input type="date" id="startDate" name="startDate" required />
            </div>
            <div class="field-group">
              <label for="endDate">End Date</label>
              <input type="date" id="endDate" name="endDate" required />
            </div>
          </div>
        </section>

        <section class="card">
          <div class="card-header">
            <h3>Data Selection</h3>
            <div class="template-pills">
              <button type="button" class="pill" onclick="applyTemplate('safety')">🛡️ Safety</button>
              <button type="button" class="pill" onclick="applyTemplate('efficiency')">⚡ Efficiency</button>
              <button type="button" class="pill" onclick="applyTemplate('exec')">📊 Executive</button>
              <button type="button" class="pill" onclick="applyTemplate('all')">🌐 Full Audit</button>
            </div>
          </div>

          <div class="checkbox-grid" id="metrics-grid">
            <label class="check-item"><input type="checkbox" name="fields" value="policyCompliance"> Policy Compliance</label>
            <label class="check-item"><input type="checkbox" name="fields" value="responseHelpfulness"> Helpfulness</label>
            <label class="check-item"><input type="checkbox" name="fields" value="responseTime"> Response Time</label>
            <label class="check-item"><input type="checkbox" name="fields" value="energyConsumption"> Energy (J)</label>
            <label class="check-item"><input type="checkbox" name="fields" value="tokensUsed"> Tokens Used</label>
            <label class="check-item"><input type="checkbox" name="fields" value="gigaFlopsUsed"> GFLOPs</label>
            <label class="check-item"><input type="checkbox" name="fields" value="webLookups"> Web Lookups</label>
            <label class="check-item"><input type="checkbox" name="fields" value="toxicityScore"> Toxicity</label>
            <label class="check-item"><input type="checkbox" name="fields" value="piiDetected"> PII Detected</label>
            <label class="check-item"><input type="checkbox" name="fields" value="queryCount"> Query Count</label>
            <label class="check-item"><input type="checkbox" name="fields" value="flaggedCount"> Flagged Count</label>
          </div>

          <div class="special-selection">
            <label class="check-item special">
              <input type="checkbox" name="fields" value="flaggedOutputs">
              <strong>Include Raw Flagged Outputs</strong> (Detailed Appendix)
            </label>
          </div>

          <div class="template-actions">
            <button type="button" class="btn-secondary" onclick="alert('Configuration saved as template!')">
              <i class="fa-solid fa-floppy-disk"></i> Save as New Template
            </button>
          </div>
        </section>

        <div class="action-bar">
          <button id="report-submit" type="submit" class="btn-primary">Generate Preview</button>
          <div class="download-group">
            <button id="report-download" type="button" class="btn-download pdf">PDF</button>
            <button id="report-download-csv" type="button" class="btn-download csv">CSV</button>
            <button id="report-download-csv-aggregates" type="button" class="btn-download agg">Aggregates</button>
          </div>
        </div>
      </form>

      <div id="report-preview-wrapper">
        <iframe id="report-preview"></iframe>
      </div>
    </div>
  </main>
</body>

</html>