<!DOCTYPE html>
<html lang="en">
<head>
  <base href="<%= process.env.PUBLIC_URL || '/' %>">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile</title>

  <link rel="stylesheet" href="css/themes/colors-default.css">
  <link rel="stylesheet" id="theme-colors" href="">
  <link rel="stylesheet" id="theme-layout" href="css/layouts/default.css">
  <link rel="stylesheet" href="css/components/notifications.css">


  <script>
    window.CURRENT_USER_ID = "<%= user ? user._id : '' %>";
  </script>
  <script src="https://kit.fontawesome.com/dd0a7425a6.js" crossorigin="anonymous"></script>
  <script src="js/notifications.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
</head>
<body>
  <%- include('./components/header') %>
  <%- include('./components/nav') %>

  <main class="content">
    <h2>Profile</h2>

    <!-- User Info Section -->
    <div class="panel-section" style="max-width: 600px; margin-bottom: 2rem;">
      <h3>Welcome, <%= user ? user.username : 'User' %>!</h3>
      <div class="user-info-display">
        <p><strong>Username:</strong> <%= user.username %></p>
        <p><strong>Email:</strong> <%= user.email %></p>
      </div>
    </div>

    <!-- Change Password Section -->
    <div class="panel-section" style="max-width: 600px;">
      <h3>Change Password</h3>
      <div id="profile-messages"></div>
      <form id="change-password-form">
        <div class="form-group">
          <label for="currentPassword">Current Password</label>
          <input type="password" id="currentPassword" required>
        </div>
        <div class="form-group">
          <label for="newPassword">New Password</label>
          <input type="password" id="newPassword" required minlength="8">
        </div>
        <div class="form-group">
          <label for="confirmPassword">Confirm New Password</label>
          <input type="password" id="confirmPassword" required minlength="8">
        </div>
        <div class="button-group">
          <button class="btn-primary" type="submit">Change Password</button>
        </div>
      </form>
    </div>

    <!-- Theme Management -->
    <div class="panel-section" style="max-width: 600px; margin-bottom: 2rem;">
      <h3>Theme</h3>
      <label for="theme-select">Select Theme:</label>
      <select id="theme-select">
        <option value="default" <%= user.preferredTheme === 'default' ? 'selected' : '' %>>Default</option>
        <option value="ocean" <%= user.preferredTheme === 'ocean' ? 'selected' : '' %>>Ocean</option>
        <option value="sunset" <%= user.preferredTheme === 'sunset' ? 'selected' : '' %>>Sunset</option>
        <option value="compact" <%= user.preferredTheme === 'compact' ? 'selected' : '' %>>Compact (Top Nav)</option>
      </select>
</main>

  <script src="/js/profile.js" defer></script>
</body>
</html>