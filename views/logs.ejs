<!DOCTYPE html>
<html lang="en">

<head>
  <base href="<%= process.env.PUBLIC_URL || '/' %>">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Model Logs</title>

  <!-- CSS -->
  <link rel="stylesheet" href="css/themes/colors-default.css">
  <link rel="stylesheet" id="theme-colors" href="">
  <link rel="stylesheet" id="theme-layout" href="css/layouts/default.css">
  <link rel="stylesheet" href="css/components/notifications.css">
  <link rel="stylesheet" href="css/components/tables.css">
  <link rel="stylesheet" href="css/components/pagination.css">
  <link rel="stylesheet" href="css/pages/logs.css">
  <link rel="stylesheet" href="css/components/modals.css">

  <!-- Scripts -->
  <script src="js/components/pagination.js" defer></script>
  <script src="js/logging.js" type="module" defer></script>
  <script src="https://kit.fontawesome.com/dd0a7425a6.js" crossorigin="anonymous"></script>
  <script src="js/notifications.js" defer></script>
  <script type="module" src="js/components/tags/tagModal.js"></script>
  <script>
    window.USER_PERMISSIONS = <%- JSON.stringify(permissions || []) %>;
    window.CONSTANTS = <%- JSON.stringify(constants) %>;
    window.DEEP_LINK = <%- JSON.stringify(deepLink) %>;
  </script>

</head>

<body>
  <%- include('components/header') %>
  <%- include('components/nav') %>
  <main class="content">

    <div class="logs-toolbar">
      <div class="log-tabs">
        <button id="user-logs-btn" class="log-tab-btn active" data-view="user">User Logs</button>
        <button id="ai-logs-btn" class="log-tab-btn" data-view="ai">AI Logs</button>
        <button id="ai-summaries-btn" class="log-tab-btn" data-view="summary">AI Summaries</button>
      </div>

      <div class="filter-container">

        <form id="user-filter-form" class="filter-group">
          <button type="button" class="btn-secondary clear-filters">Clear</button>

          <label for="user-search">Search:</label>
          <input type="text" id="user-search" name="search" placeholder="Search logs...">

          <label for="filter-start-date">From:</label>
          <input type="date" id="filter-start-date" name="start">

          <label for="filter-end-date">To:</label>
          <input type="date" id="filter-end-date" name="end">

          <label for="filter-event-type">Event:</label>
          <select id="filter-event-type" name="eventType">
            <!-- ToDo: These are all hardcoded - change that -->
            <option value="all" selected>All Events</option>
            <option value="Login">Login</option>
            <option value="Logout">Logout</option>
            <option value="Alert_Created">Alert Created</option>
            <option value="Alert_Modified">Alert Modified</option>
            <option value="Alert_Deleted">Alert Deleted</option>
            <option value="Report_Created">Report Created</option>
            <option value="Report_Deleted">Report Deleted</option>
            <option value="Unspecified_Event">Unspecified Event</option>
          </select>
          <button type="submit" class="btn-primary">Apply</button>
        </form>

        <form id="ai-filter-form" class="filter-group hidden">
          <button type="button" class="btn-secondary clear-filters">Clear</button>

          <label for="ai-search">Search:</label>
          <input type="text" id="ai-search" name="search" placeholder="Search logs...">

          <label for="ai-filter-start-date">From:</label>
          <input type="date" id="ai-filter-start-date" name="start">

          <label for="ai-filter-end-date">To:</label>
          <input type="date" id="ai-filter-end-date" name="end">

          <label for="filter-model">Model:</label>
          <select id="filter-model" name="modelName">
            <option value="all" selected>All Models</option>
            <!-- ToDo: These options are hard coded right now - change that -->
            <option value="GoodModel">Good Model</option>
            <option value="BadModel">Bad Model</option>
          </select>
          <button type="submit" class="btn-primary">Apply</button>
        </form>

        <form id="ai-summary-filter-form" class="filter-group hidden">
          <button type="button" class="btn-secondary clear-filters">Clear</button>

          <label for="ai-summary-search">Search:</label>
          <input type="text" id="ai-summary-search" name="search" placeholder="Search summaries...">

          <label for="summary-filter-start-date">From:</label>
          <input type="date" id="summary-filter-start-date" name="start">

          <label for="summary-filter-end-date">To:</label>
          <input type="date" id="summary-filter-end-date" name="end">

          <label for="summary-filter-model">Model:</label>
          <select id="summary-filter-model" name="modelName">
            <option value="all" selected>All Models</option>
            <!-- ToDo: These options are hard coded right now - change that -->
            <option value="GoodModel">Good Model</option>
            <option value="BadModel">Bad Model</option>
          </select>
          <button type="submit" class="btn-primary">Apply</button>
        </form>

      </div>
    </div>

    <div class="second-logs-toolbar">
      <div class="manage-tags-container">
        <button id="open-tags-modal-btn" class="btn btn-secondary hidden">
          <i class="fa-solid fa-tags"></i> Manage Tags
        </button>
      </div>


      <div class="filter-actions">
        <div class="live-toggle-container hidden" id="live-updates-container">
          <label class="switch">
            <input type="checkbox" id="live-update-toggle" checked>
            <span class="slider round"></span>
          </label>
          <span class="live-label">Live Updates</span>
        </div>
      </div>
    </div>

    <div class="log-view-container">

      <div id="user-log-view">
        <table class="log-table">
          <thead>
            <tr>
              <th class="col-type">Type</th>
              <th class="col-time">Timestamp</th>
              <th class="col-user">User</th>
              <th class="col-action">Action</th>
              <th class="col-details">Details</th>
            </tr>
          </thead>
          <tbody id="user-log-tbody">
          </tbody>
        </table>
        <div id="pagination-controls" class="pagination">
        </div>
      </div>

      <div id="ai-log-view" class="hidden">
        <div id="ai-log-accordion">
        </div>
        <div id="ai-pagination-controls" class="pagination">
        </div>
      </div>

      <div id="ai-summary-view" class="hidden">
        <div id="ai-summary-accordion">
        </div>
        <div id="ai-summary-pagination-controls" class="pagination">
        </div>
      </div>

    </div>

    <%- include('components/modal') %>

  </main>
</body>

</html>