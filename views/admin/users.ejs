<!DOCTYPE html>
<html lang="en">

<head>
  <base href="<%= process.env.PUBLIC_URL || '/' %>">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Management</title>

  <!-- CSS -->
  <link rel="stylesheet" href="css/themes/colors-default.css">
  <link rel="stylesheet" id="theme-colors" href="">
  <link rel="stylesheet" id="theme-layout" href="css/layouts/default.css">
  <link rel="stylesheet" href="css/components/notifications.css">
  <link rel="stylesheet" href="css/components/tables.css">
  <link rel="stylesheet" href="css/pages/admin.css">

  <!-- Scripts -->
  <script src="js/sseManager.js"></script>
  <script>
    window.USER_PERMISSIONS = <%- JSON.stringify(permissions || []) %>;
  </script>
  <script src="https://kit.fontawesome.com/dd0a7425a6.js" crossorigin="anonymous"></script>
  <script src="js/notifications.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

</head>

<body>
  <%- include('../components/header') %>
  <%- include('../components/nav') %>

  <main class="content">
    <h2>Management</h2>

    <div class="admin-panel">

      <!-- Users Section -->
      <section class="collapsible-section" data-section="users">
        <button type="button" class="collapse-toggle" aria-expanded="true">Users ▾</button>
        <div class="collapsible-content" id="users-section">
          <div class="panel-section">

            <!-- Search and Filter Section -->
            <div class="admin-section" style="margin-bottom: 1.5rem;">
              <h4 style="margin-top: 0; font-size: 0.95rem; color: #666; margin-bottom: 0.75rem;">Search & Filter</h4>
              <div class="filter-group">
                <input type="text" id="user-search" class="form-control" placeholder="Search username or email..." />
                <select id="role-filter" class="form-control">
                  <option value="">All Roles</option>
                </select>
                <button id="refresh-users" type="button" class="btn btn-secondary" title="Refresh users list">
                  <i class="fa-solid fa-arrows-rotate"></i> Refresh
                </button>
              </div>
            </div>

            <!-- Bulk Actions Section -->
            <div class="admin-section" style="margin-bottom: 1.5rem;">
              <h4 style="margin-top: 0; font-size: 0.95rem; color: #666; margin-bottom: 0.75rem;">Bulk Actions</h4>
              <div class="bulk-actions">
                <select id="bulk-role-select" class="form-control">
                  <option value="">-- Change role to --</option>
                </select>
                <button id="apply-bulk-role" type="button" class="btn btn-primary">Apply</button>
                <button id="delete-selected" type="button" class="btn btn-danger">Delete Selected</button>
              </div>
            </div>

            <!-- Users Table -->
            <div id="users-container">
              <!-- Table is rendered by client JS -->
            </div>
          </div>
        </div>
      </section>

      <!-- Roles Section -->
      <section class="collapsible-section" data-section="roles">
        <button type="button" class="collapse-toggle" aria-expanded="true">Roles ▾</button>
        <div class="collapsible-content" id="roles-section">
          <div class="panel-section">
            <!-- Create New Role Section -->
            <div class="admin-section">
              <h4>Create New Role</h4>
              <div id="role-messages"></div>
              <form id="create-role-form">
                <div class="form-group">
                  <label for="role-name">Role Name:</label>
                  <input type="text" id="role-name" placeholder="e.g., moderator" required minlength="3" maxlength="50">
                </div>

                <div class="form-group">
                  <label for="role-description">Description:</label>
                  <textarea id="role-description" placeholder="Describe this role's purpose" required minlength="5" maxlength="500"></textarea>
                </div>

                <div class="form-group">
                  <label>Permissions:</label>
                  <div class="permissions-list" id="permissions-list">
                    <!-- Permissions are loaded by client JS -->
                  </div>
                </div>

                <div class="button-group">
                  <button type="submit" class="btn-primary">Create Role</button>
                  <button type="reset" class="btn-secondary">Clear</button>
                </div>
              </form>
            </div>

            <!-- Existing Roles Section -->
            <div class="admin-section">
              <h4>Existing Roles</h4>
              <div id="roles-list" class="roles-list">
                <!-- Roles are rendered by client JS -->
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- System Section -->
      <section class="collapsible-section" data-section="system">
        <button type="button" class="collapse-toggle" aria-expanded="true">System ▾</button>
        <div class="collapsible-content" id="system-section">
          <div class="panel-section">
            <div class="admin-section">
              <h4>AI Log Retention</h4>
              <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem;">
                AI logs older than this duration are automatically deleted. Summaries are kept regardless.
              </p>
              <div id="system-messages"></div>
              <div class="form-group" style="max-width: 300px;">
                <label for="ai-log-cutoff">Keep AI logs for:</label>
                <select id="ai-log-cutoff" class="form-control">
                  <option value="3600000">1 Hour</option>
                  <option value="21600000">6 Hours</option>
                  <option value="43200000">12 Hours</option>
                  <option value="86400000">1 Day</option>
                  <option value="259200000">3 Days</option>
                  <option value="604800000">1 Week</option>
                  <option value="1209600000">2 Weeks</option>
                  <option value="2592000000">1 Month</option>
                  <option value="-1">Forever (Never Delete)</option>
                  <option value="custom">Custom Duration...</option>
                </select>
              </div>
              <div id="custom-cutoff-container" class="form-group" style="max-width: 300px; display: none; margin-top: 0.75rem;">
                <label>Custom duration:</label>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                  <input type="number" id="custom-cutoff-value" class="form-control" min="1" placeholder="e.g. 30" style="flex: 1;">
                  <select id="custom-cutoff-unit" class="form-control" style="flex: 1;">
                    <option value="60000">Minutes</option>
                    <option value="3600000">Hours</option>
                    <option value="86400000" selected>Days</option>
                    <option value="2592000000">Months (30d)</option>
                    <option value="31536000000">Years (365d)</option>
                  </select>
                </div>
              </div>
              <button id="save-ai-log-cutoff" type="button" class="btn btn-primary" style="margin-top: 0.75rem;">Save</button>

              <hr style="margin: 1.5rem 0;" />

              <h4>Default Theme for New Users</h4>
              <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem;">This theme will be assigned to accounts created going forward.</p>
              <div class="form-group" style="max-width: 280px;">
                <label for="default-theme-select">Default Theme</label>
                <select id="default-theme-select" class="form-control" aria-label="Select default theme for new users">
                  <option value="default">Default</option>
                  <option value="compact">Compact-Design</option>
                  <option value="contrast">High-Contrast</option>
                  <option value="cosmic">Cosmic</option>
                  <option value="ocean">Ocean</option>
                  <option value="sakura">Sakura</option>
                  <option value="sunset">Sunset</option>
                  <option value="viridian">Viridian</option>
                </select>
              </div>
              <button id="save-default-theme" type="button" class="btn btn-primary">Save Default Theme</button>

              <hr style="margin: 1.5rem 0;" />

              <h4>Server Control</h4>
              <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem;">Only use these actions when you intend to stop or restart the server process.</p>
              <div class="button-group" style="gap: 0.75rem; flex-wrap: wrap;">
                <button id="shutdown-server" type="button" class="btn btn-danger">Shutdown Server</button>
                <button id="restart-server" type="button" class="btn btn-warning">Restart Server</button>
              </div>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <script>
    window.AVAILABLE_ROLES = <%- JSON.stringify(rolesList || []) %>;
    window.CURRENT_USER_ID = "<%= user ? user._id : '' %>";
    window.USER_PERMISSIONS = <%- JSON.stringify(permissions || []) %>;
  </script>
  <script src="js/adminUsers.js" defer></script>
</body>

</html>