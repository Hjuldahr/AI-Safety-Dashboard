<!DOCTYPE html>
<html lang="en">

<head>
  <base href="<%= process.env.PUBLIC_URL || '/' %>">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login / Sign Up</title>

  <!-- CSS -->
  <link rel="stylesheet" href="css/themes/colors-default.css">
  <link rel="stylesheet" id="theme-colors" href="">
  <link rel="stylesheet" id="theme-layout" href="css/layouts/default.css">
  <link rel="stylesheet" href="css/pages/login.css">

  <!-- Scripts -->
  <script src="js/auth.js" defer></script>
  <script src="https://kit.fontawesome.com/dd0a7425a6.js" crossorigin="anonymous"></script>
  <script src="js/notifications.js" defer></script>
  <script src="js/darkMode.js"></script>
  <script src="js/themeManager.js"></script>
</head>

<body class="auth-page">
  <script>
    // Anti-FOUC: apply theme before paint
    (function() {
      var t = localStorage.getItem('theme');
      if (t && t !== 'default') document.body.classList.add('theme-' + t);
      // Swap color stylesheet link
      var colorMap = { ocean: 'css/themes/colors-ocean.css', sunset: 'css/themes/colors-sunset.css' };
      var colorLink = document.getElementById('theme-colors');
      if (colorLink) colorLink.href = colorMap[t] || '';
      // Swap layout stylesheet link
      var layoutLink = document.getElementById('theme-layout');
      if (layoutLink) layoutLink.href = (t === 'compact') ? 'css/layouts/compact.css' : 'css/layouts/default.css';
    })();
  </script>

  <div class="auth-container">
    <div class="title-container">
      <div class="site-title">
        <h1>AI Safety Dashboard</h1>
      </div>
    </div>

    <div class="auth-card">
      <!-- Tab Navigation -->
      <div class="tab-nav">
        <button id="signInTab" class="tab-button tab-active">Sign In</button>
        <button id="signUpTab" class="tab-button">Sign Up</button>
      </div>

      <!-- Error Message Display -->
      <div id="errorMessage" class="error-message hidden">
        <span></span>
      </div>

      <!-- Sign In Form -->
      <form id="signInForm" class="auth-form">
        <div class="form-group">
          <label for="signInInput">Username or Email Address</label>
          <input type="text" id="signInInput" name="username" required>
        </div>
        <div class="form-group">
          <label for="signInPassword">Password</label>
          <input type="password" id="signInPassword" name="password" required>
        </div>
        <div class="form-group">
          <button type="submit" class="submit-button">Sign In</button>
        </div>
      </form>

      <!-- Sign Up Form (hidden by default) -->
      <form id="signUpForm" class="auth-form hidden">
        <div class="form-group">
          <label for="signUpUsername">Username</label>
          <input type="text" id="signUpUsername" name="username" required>
        </div>
        <div class="form-group">
          <label for="signUpEmail">Email Address</label>
          <input type="email" id="signUpEmail" name="email" required>
        </div>
        <div class="form-group">
          <label for="signUpPassword">Password</label>
          <input type="password" id="signUpPassword" name="password" required>
        </div>
        <div class="form-group">
          <label for="signUpConfirmPassword">Confirm Password</label>
          <input type="password" id="signUpConfirmPassword" name="confirmPassword" required>
        </div>
        <div class="form-group">
          <button type="submit" class="submit-button">Create Account</button>
        </div>
      </form>
    </div>
    <div class="spacer"></div>
    <div class="back-btn-container">
      <a href="./"><button class="back-btn">Back to Index Page</button></a>
    </div>
  </div>
</body>

</html>