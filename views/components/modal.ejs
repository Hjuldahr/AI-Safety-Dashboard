<!-- This component can be re-used to get pop-up modals to appear on screen to prompt user interaction -->

<div id="global-modal" class="modal-overlay" style="display: none">
  <div id="global-modal-content" class="modal-content">
    <div class="modal-header">
      <h2 id="global-modal-title"></h2>
      <button class="close-modal-btn">&times;</button>
    </div>
    <div id="global-modal-body" class="modal-body">
    </div>
    <div id="global-modal-footer" class="modal-footer">
    </div>
  </div>
</div>