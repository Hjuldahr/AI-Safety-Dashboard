<script>
    // Anti-FOUC: apply server-rendered user preferences before paint
    window.USER_PREFERENCES = {
        preferredTheme: "<%= (typeof user !== 'undefined' && user && user.preferredTheme) ? user.preferredTheme : 'default' %>",
        darkModeEnabled: <%= (typeof user !== 'undefined' && user && user.darkModeEnabled) ? 'true' : 'false' %>,
        isAuthenticated: <%= (typeof user !== 'undefined' && !!user) ? 'true' : 'false' %>
    };

    if (window.USER_PREFERENCES.darkModeEnabled) {
        document.body.classList.add('dark-mode');
    }

  (function() {
        var theme = (window.USER_PREFERENCES && window.USER_PREFERENCES.preferredTheme) || 'default';
    if (theme && theme !== 'default') {
      document.body.classList.add('theme-' + theme);
    }
    // Swap color stylesheet link
    var colorMap = { ocean: 'css/themes/colors-ocean.css', sunset: 'css/themes/colors-sunset.css' };
    var colorLink = document.getElementById('theme-colors');
    if (colorLink) colorLink.href = colorMap[theme] || '';
    // Swap layout stylesheet link
    var layoutLink = document.getElementById('theme-layout');
    if (layoutLink) layoutLink.href = (theme === 'compact') ? 'css/layouts/compact.css' : 'css/layouts/default.css';
  })();
</script>
<header class="site-header">
    <h1>AI Safety Dashboard</h1>
    <div class="header-controls">
        <button id="dark-mode-toggle" class="dark-mode-toggle" title="Toggle dark mode">
            <i class="fa-solid fa-moon"></i>
        </button>
        <% if(user){ %>
            <div class="userInfo">
                <p id="user-name">User: <%= user.username%>
                </p>
                <a href="profile" class="profile-icon" title="Profile" style="margin-right:0.5rem;">
                    <i class="fa-solid fa-user-gear"></i>
                </a>
                <form action="api/logout" method="post" class="logout-form">
                    <button type="submit" id="logout-btn"><i class='fa-solid fa-door-closed'></i> Logout</button>
                </form>
            </div>

            <% } else { %>
                <div class="login-button">
                    <a href="login" id="login-text">Login</a>
                </div>
                <% } %>
        <%- include('notifications') %>
    </div>
    <script>
        const logoutBtn = document.getElementById('logout-btn');
        logoutBtn.addEventListener('mouseenter', () => 
            logoutBtn.innerHTML = "<i class='fa-solid fa-door-open'></i> Logout"
        );
        logoutBtn.addEventListener('mouseleave', () => 
            logoutBtn.innerHTML = "<i class='fa-solid fa-door-closed'></i> Logout"
        );
    </script>
</header>
<script src="js/darkMode.js"></script>
<script src="js/themeManager.js"></script>