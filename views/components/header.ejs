<header class="site-header">
    <h1>AI Safety Dashboard</h1>
    <div class="header-controls">
        <% if(user){ %>
            <div class="userInfo">
                <p id="user-name">User: <%= user.username%>
                </p>
                <a href="profile" class="profile-icon" title="Profile" style="margin-right:0.5rem;">
                    <i class="fa-solid fa-user-gear"></i>
                </a>
                <form action="api/logout" method="post" class="logout-form">
                    <button type="submit" id="logout-btn"><i class='fa-solid fa-door-closed'></i> Logout</button>
                </form>
            </div>

            <% } else { %>
                <div class="login-button">
                    <a href="login" id="login-text">Login</a>
                </div>
                <% } %>
        <%- include('notifications') %>
    </div>
    <script>
        const logoutBtn = document.getElementById('logout-btn');
        logoutBtn.addEventListener('mouseenter', () => 
            logoutBtn.innerHTML = "<i class='fa-solid fa-door-open'></i> Logout"
        );
        logoutBtn.addEventListener('mouseleave', () => 
            logoutBtn.innerHTML = "<i class='fa-solid fa-door-closed'></i> Logout"
        );
    </script>
</header>