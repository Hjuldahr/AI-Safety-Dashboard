<script>
  // Anti-FOUC: apply dark mode and theme instantly before paint
  if (localStorage.getItem('darkMode') === 'true') {
    document.body.classList.add('dark-mode');
  }
  (function() {
    var theme = localStorage.getItem('theme');
    if (theme && theme !== 'default') {
      document.body.classList.add('theme-' + theme);
    }
  })();
</script>
<header class="site-header">
    <h1>AI Safety Dashboard</h1>
    <div class="header-controls">
        <button id="dark-mode-toggle" class="dark-mode-toggle" title="Toggle dark mode">
            <i class="fa-solid fa-moon"></i>
        </button>
        <% if(user){ %>
            <div class="userInfo">
                <p id="user-name">User: <%= user.username%>
                </p>
                <a href="profile" class="profile-icon" title="Profile" style="margin-right:0.5rem;">
                    <i class="fa-solid fa-user"></i>
                </a>
                <form action="api/logout" method="post" class="logout-form">
                    <button type="submit" id="logout-btn">Logout</button>
                </form>
            </div>

            <% } else { %>
                <div class="login-button">
                    <a href="login" id="login-text">Login</a>
                </div>
                <% } %>
        <%- include('notifications') %>
    </div>
</header>
<script src="js/darkMode.js"></script>
<script src="js/themeManager.js"></script>