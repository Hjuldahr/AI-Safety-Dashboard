<!DOCTYPE html>
<html lang="en">

<head>
  <base href="<%= process.env.PUBLIC_URL || '/' %>">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alerts</title>

  <link rel="stylesheet" href="css/fullSite.css">
  <link rel="stylesheet" href="css/header.css">
  <link rel="stylesheet" href="css/alerts.css">
  <link rel="stylesheet" href="css/nav.css">
  <link rel="stylesheet" href="css/notifications.css">

  <script src="https://kit.fontawesome.com/dd0a7425a6.js" crossorigin="anonymous"></script>
  <script>
    window.USER_PERMISSIONS = <%- JSON.stringify(permissions || []) %>;
  </script>
  <script src="js/alerts.js" defer></script>
  <script src="js/notifications.js" defer></script>
</head>

<body>
  <script id="constants-json" type="application/json">
    <%- JSON.stringify(constants || {}) %>
  </script>
  <script>
    //Grab the constants sent on page load
    window.CONSTANTS = JSON.parse(document.getElementById('constants-json').textContent);

    // Unpacking the obj
    const {
      DATA_DICTIONARY,
      CHART_TYPES,
      CHART_SIZES,
      KNOWN_MODELS,
      TOPIC_HIERARCHY
    } = window.CONSTANTS;
  </script>

  <%- include('components/header') %>
  <%- include('components/nav') %>

  <main class="content">
    <div class="main-container">
      <section class="card alert-builder">
        <h2 class="card-title">Alert Builder</h2>
        <div class="alert-builder-grid">

          <div class="form-group">
            <label for="alert-name">Alert Name:</label>
            <input type="text" id="alert-name" name="alert-name" placeholder="Alert 1...">
          </div>

          <div class="form-group">
            <label for="alert-level">Alert Level:</label>
            <select id="alert-level" name="alert-level">
              <option value="">-- select alert level --</option>
              <option value="Critical">Critical</option>
              <option value="High">High</option>
              <option value="Medium">Medium</option>
              <option value="Info">Info</option>
            </select>
          </div>

          <div class="form-group model-group">
            <label for="model-name">Model (optional):</label>
            <select id="model-name" name="model-name" class="model-select-dynamic">
            </select>
          </div>

          <div class="form-group tags-group">
            <label for="tag-dual-left">Tags:</label>
            <div class="dual-list" style="display:flex; gap:0.5rem; align-items:center;">
                <div style="flex:1;">
                <div class="dual-list-label">Available</div>
                <div id="tag-dual-left" class="dual-list-box" role="listbox" aria-multiselectable="true"></div>
              </div>
              <div style="display:flex; flex-direction:column; gap:6px; align-items:center;">
                <button type="button" id="move-selected-right" class="btn btn-secondary">▶</button>
                <button type="button" id="move-all-right" class="btn btn-secondary">≫</button>
                <button type="button" id="move-selected-left" class="btn btn-secondary">◀</button>
                <button type="button" id="move-all-left" class="btn btn-secondary">≪</button>
              </div>
              <div style="flex:1;">
                <div class="dual-list-label">Selected</div>
                <div id="tag-dual-right" class="dual-list-box" role="listbox" aria-multiselectable="true"></div>
              </div>
            </div>
            <div id="selected-tags" class="selected-tags" style="margin-top:8px;"></div>
          </div>

          <div class="form-group add-alert-button-container">
            <button id="add-alert-btn" class="btn btn-primary">Add Alert</button>
          </div>

          <div class="rule-builder form-group rule-group">
            <label>Alert Rule:</label>
            <div class="rule-builder-inputs" id="rules-container">
            </div>

            <div class="logical-operators-container">
              <span class="rule-builder-note">(add another part to the rule)</span>
              <div class="logical-operators">
                <button class="btn btn-secondary add-rule-btn" data-logic="AND">AND</button>
                <button class="btn btn-secondary add-rule-btn" data-logic="OR">OR</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="alerts-layout">
        <aside class="card live-alerts-panel">
          <h2 class="card-title">View and Edit Live Alerts</h2>
          <ul id="live-alerts-list" class="live-alerts-list">
          </ul>
          <div class="card" style="margin-top:1rem; padding:0.75rem;">
            <label>Manage Tags</label>
            <div id="tag-editor-pills" style="width:100%; display:flex; gap:0.4rem; flex-wrap:wrap; margin-top:0.5rem;"></div>
            <div id="tag-editor-rows" style="display:none; width:100%; margin-top:0.5rem;"></div>
            <div style="margin-top:0.5rem; display:flex; gap:0.5rem; align-items:center;">
              <button id="edit-tags-btn" class="btn btn-secondary">Edit</button>
              <button id="confirm-tags-btn" class="btn btn-primary" style="display:none;">Confirm</button>
              <button id="cancel-tags-btn" class="btn btn-secondary" style="display:none;">Cancel</button>
              <button id="add-tag-row-btn" class="btn btn-secondary" style="display:none; margin-left: auto;">Add Row</button>
            </div>
          </div>
        </aside>

        <div class="card alert-log-panel">
          <div class="card-header-flex">
            <h2 class="card-title">Alert History</h2>
          </div>

          <div class="filter-container" style="margin-bottom: 15px;">
            <form id="history-filter-form" class="filter-group">
              <button type="button" class="btn-secondary clear-filters">Clear</button>

              <label for="filter-level">Level:</label>
              <select id="filter-level" name="level">
                <option value="all">All Levels</option>
                <option value="Critical">Critical</option>
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Info">Info</option>
              </select>

              <label for="filter-model">Model:</label>
              <select id="filter-model" name="model" class="model-select-dynamic">
              </select>

              <label for="filter-tag">Tag:</label>
              <select id="filter-tag" name="tag">
                <option value="all">All Tags</option>
              </select>

              <label for="filter-start-date">From:</label>
              <input type="date" id="filter-start-date" name="startDate">

              <label for="filter-end-date">To:</label>
              <input type="date" id="filter-end-date" name="endDate">

              <button type="submit" class="btn-primary">Apply</button>
            </form>
          </div>

          <div class="table-container">
            <table class="alert-log-table">
              <thead>
                <tr>
                  <th>Level</th>
                  <th>Time</th>
                  <th>Alert</th>
                  <th>Model</th>
                  <th>Triggered By</th>
                  <th>Tags</th>
                </tr>
              </thead>
              <tbody id="alert-log-body">
                <tr>
                  <td colspan="6">Loading history...</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div id="history-pagination" class="pagination"></div>
        </div>
      </div>
    </div>
  </main>
</body>

</html>