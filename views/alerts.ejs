<!DOCTYPE html>
<html lang="en">

<head>
  <base href="<%= process.env.PUBLIC_URL || '/' %>">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alerts</title>

  <link rel="stylesheet" href="css/fullSite.css">
  <link rel="stylesheet" href="css/motd.css">
  <link rel="stylesheet" href="css/header.css">
  <link rel="stylesheet" href="css/alerts.css">
  <link rel="stylesheet" href="css/nav.css">
  <link rel="stylesheet" href="css/notifications.css">

  <script src="js/alerts.js" defer></script>
  <script src="https://kit.fontawesome.com/dd0a7425a6.js" crossorigin="anonymous"></script>
  <script src="js/notifications.js" defer></script>

  <script src="js/motd.js" defer></script>
</head>

<body>
  <script>
    //Grab the constants sent on page load
    window.CONSTANTS = <%- JSON.stringify(constants) %>;

    // Unpacking the obj
    const {
      DATA_DICTIONARY,
      CHART_TYPES,
      CHART_SIZES,
      KNOWN_MODELS,
      TOPIC_HIERARCHY
    } = window.CONSTANTS;
  </script>

  <%- include('components/motd') %>
  <%- include('components/header') %>
  <%- include('components/nav') %>

  <main class="content">
    <div class="main-container">
      <section class="card alert-builder">
        <h2 class="card-title">Alert Builder</h2>
        <div class="alert-builder-grid">

          <div class="form-group">
            <label for="alert-name">Alert Name:</label>
            <input type="text" id="alert-name" name="alert-name" placeholder="Alert 1...">
          </div>

          <div class="form-group">
            <label for="alert-level">Alert Level:</label>
            <select id="alert-level" name="alert-level">
              <option value="">-- select alert level --</option>
              <option value="Critical">Critical</option>
              <option value="High">High</option>
              <option value="Medium">Medium</option>
              <option value="Info">Info</option>
            </select>
          </div>

          <div class="form-group">
            <label for="model-name">Model (optional):</label>
            <select id="model-name" name="model-name" class="model-select-dynamic">
            </select>
          </div>

          <div class="form-group add-alert-button-container">
            <button id="add-alert-btn" class="btn btn-primary">Add Alert</button>
          </div>

          <div class="rule-builder form-group">
            <label>Alert Rule:</label>
            <div class="rule-builder-inputs" id="rules-container">
            </div>

            <div class="logical-operators-container">
              <span class="rule-builder-note">(add another part to the rule)</span>
              <div class="logical-operators">
                <button class="btn btn-secondary add-rule-btn" data-logic="AND">AND</button>
                <button class="btn btn-secondary add-rule-btn" data-logic="OR">OR</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="alerts-layout">
        <aside class="card live-alerts-panel">
          <h2 class="card-title">View and Edit Live Alerts</h2>
          <ul id="live-alerts-list" class="live-alerts-list">
          </ul>
        </aside>

        <div class="card alert-log-panel">
          <div class="card-header-flex">
            <h2 class="card-title">Alert History</h2>
          </div>

          <div class="filter-container" style="margin-bottom: 15px;">
            <form id="history-filter-form" class="filter-group">
              <button type="button" class="btn-secondary clear-filters">Clear</button>

              <label for="filter-level">Level:</label>
              <select id="filter-level" name="level">
                <option value="all">All Levels</option>
                <option value="Critical">Critical</option>
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Info">Info</option>
              </select>

              <label for="filter-model">Model:</label>
              <select id="filter-model" name="model" class="model-select-dynamic">
              </select>

              <label for="filter-start-date">From:</label>
              <input type="date" id="filter-start-date" name="startDate">

              <label for="filter-end-date">To:</label>
              <input type="date" id="filter-end-date" name="endDate">

              <button type="submit" class="btn-primary">Apply</button>
            </form>
          </div>

          <div class="table-container">
            <table class="alert-log-table">
              <thead>
                <tr>
                  <th>Level</th>
                  <th>Time</th>
                  <th>Alert</th>
                  <th>Model</th>
                  <th>Triggered By</th>
                </tr>
              </thead>
              <tbody id="alert-log-body">
                <tr>
                  <td colspan="5">Loading history...</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div id="history-pagination" class="pagination"></div>
        </div>
      </div>
    </div>
  </main>
</body>

</html>