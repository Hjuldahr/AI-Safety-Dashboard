<!doctype html>
<html>
<head>
  <base href="<%= process.env.PUBLIC_URL || '/' %>">
  <meta charset="utf-8" />
  <title><%= reportTitle %></title>
  <style>
    body { font-family: Arial, sans-serif; padding: 20px; color: #222; }
    header { text-align: center; margin-bottom: 10px; }
    .meta { margin-bottom: 12px; font-size: 12px; color: #333; }
    .section { margin-top: 18px; }
    table.stats td { padding: 6px 10px; font-size: 11px; }
    canvas { width: 100% !important; height: 260px !important; display:block; margin: 8px 0 18px; }
    hr { border: none; border-top: 1px solid #eee; margin: 16px 0; }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <header>
    <h1><%= reportTitle %></h1>
    <div class="meta">
      <strong>Start:</strong> <%= startDate || '—' %> &nbsp; | &nbsp;
      <strong>End:</strong> <%= endDate || '—' %> &nbsp; | &nbsp;
      <strong>Type:</strong> <%= reportType || '—' %> &nbsp; | &nbsp;
      <strong>Model:</strong> <%= modelName || '—' %>
    </div>
    <% if (notes) { %>
      <div style="font-size:11px; color:#555;"><%= notes %></div>
    <% } %>
  </header>

  <hr>

  <section class="section">
    <h2>Summary</h2>
    <table class="stats">
      <tr><td>Count</td><td><%= totalLogs %></td></tr>
      <tr><td>Min</td><td><%= stats.min %></td></tr>
      <tr><td>Avg</td><td><%= stats.avg %></td></tr>
      <tr><td>Max</td><td><%= stats.max %></td></tr>
    </table>
  </section>

  <section class="section">
    <h2>Charts</h2>
    <canvas id="chart1"></canvas>
    <canvas id="chart2"></canvas>
  </section>

  <footer style="margin-top:24px; font-size:10px; color:#777; text-align:right;">
    Generated at <%= new Date().toLocaleString() %>
  </footer>

  <script>
    (function () {
      // Chart configs are injected as JSON in controller
      const cfg1 = JSON.parse(`<%= chartConfig1 %>`);
      const cfg2 = JSON.parse(`<%= chartConfig2 %>`);
      // Render charts
      new Chart(document.getElementById('chart1'), cfg1);
      new Chart(document.getElementById('chart2'), cfg2);

      // Give Chart.js time to render before Puppeteer snapshots
      setTimeout(() => { window.renderComplete = true; }, 600);
    })();
  </script>
</body>
</html>
