<%
// Define a function to safely parse and display the date from the YYYY-MM-DD string.
// This uses UTC methods to prevent the server's local timezone from shifting the date back one day.
const formatDisplayDate = (dateString) => {
    if (!dateString) return 'N/A';
    try {
        const dateObj = new Date(dateString); 

        // Use UTC methods to extract the components.
        const year = dateObj.getUTCFullYear();
        // getUTCMonth is 0-indexed (0=Jan), so we add 1
        const month = String(dateObj.getUTCMonth() + 1).padStart(2, '0');
        const day = String(dateObj.getUTCDate()).padStart(2, '0');

        // Return the date in MM/DD/YYYY format
        return `${month}/${day}/${year}`;
    } catch(e) {
        return dateString;
    }
};
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= reportTitle %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <style>
        /* Base styles for printing */
        body { 
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif; 
            margin: 0; padding: 0; 
            color: #1f2937; /* Gray-800 */
        }
        .report-container { 
            max-width: 800px; 
            margin: 0 auto; 
            padding: 40px; 
        }
        /* Crucial: Ensure page breaks for multi-page reports */
        .page-break { page-break-after: always; }
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }
    </style>
</head>
<body class="bg-gray-50">
    <div class="report-container">

        <header class="text-center mb-12 border-b-4 border-blue-600 pb-4">
            <h1 class="text-4xl font-extrabold text-blue-800 tracking-tight"><%= reportTitle %></h1>
            <p class="text-md text-gray-600 mt-2">Log Analysis Report for Model: <%= modelName %></p>
        </header>

        <div class="bg-white p-6 rounded-xl shadow-lg mb-10 border border-gray-200">
            <h2 class="text-xl font-bold text-gray-700 mb-3 border-b pb-2">Report Context</h2>
            <div class="grid grid-cols-2 gap-4 text-sm text-gray-700">
                <div><strong>Model Analyzed:</strong> <span class="text-blue-600"><%= modelName %></span></div>
                <div><strong>Total Logs Counted:</strong> <span class="text-blue-600"><%= totalLogs.toLocaleString() %></span></div>
                <div><strong>Start Date:</strong> <%= formatDisplayDate(startDate) %></div>
                <div><strong>End Date:</strong> <%= formatDisplayDate(endDate) %></div>
            </div>
            <% if (notes && notes.trim().length > 0) { %>
                <div class="mt-4 pt-3 border-t border-gray-100">
                    <strong>Notes:</strong> <span class="text-gray-600"><%= notes %></span>
                </div>
            <% } %>
        </div>

        <h2 class="text-2xl font-bold text-gray-700 mb-5">Key Performance Indicators</h2>
        <div class="stat-grid">
            
            <% 
            const metrics = [
                { title: "Total Logs Analyzed", value: stats.count.toLocaleString(), unit: "logs", color: "bg-blue-100 text-blue-800" },
                { title: "Average Response Time", value: stats.avg.toFixed(2), unit: "ms", color: "bg-green-100 text-green-800" },
                { title: "Minimum Response Time", value: stats.min.toFixed(2), unit: "ms", color: "bg-indigo-100 text-indigo-800" },
                { title: "Maximum Response Time", value: stats.max.toFixed(2), unit: "ms", color: "bg-red-100 text-red-800" }
            ];
            
            metrics.forEach(item => { %>
                <div class="bg-white p-4 rounded-xl shadow-md border-l-4 border-blue-500">
                    <p class="text-sm font-medium text-gray-500"><%= item.title %></p>
                    <p class="text-3xl font-extrabold mt-1">
                        <%= item.value %> 
                        <span class="text-base font-normal text-gray-500"><%= item.unit %></span>
                    </p>
                </div>
            <% }); %>
        </div>

        <div class="page-break"></div> 
        <h2 class="text-2xl font-bold text-gray-700 mb-5 mt-8">Response Time Distribution</h2>
        
        <div class="p-6 bg-white rounded-xl shadow-lg" style="height: 450px; width: 100%;">
            <canvas id="responseTimeChart"></canvas>
        </div>
        
        <footer class="text-center text-xs text-gray-400 mt-12 pt-4 border-t border-gray-200">
            Generated on <%= new Date().toLocaleString() %>. Data accuracy dependent on log source availability.
        </footer>

    </div>

    <script>
        // Data passed directly from the EJS template context.
        const chartStats = {
            min: stats.min,
            max: stats.max,
            avg: stats.avg
        };
        const logCount = stats.count ;

        // Configuration for the Chart
        const chartConfig = {
            type: 'bar',
            data: {
                labels: ['Minimum', 'Average', 'Maximum'],
                datasets: [{
                    label: 'Response Time (ms)',
                    data: [chartStats.min, chartStats.avg, chartStats.max],
                    backgroundColor: ['rgba(52, 211, 153, 0.8)', 'rgba(59, 130, 246, 0.8)', 'rgba(239, 68, 68, 0.8)'], // Green, Blue, Red
                    borderColor: ['rgba(52, 211, 153, 1)', 'rgba(59, 130, 246, 1)', 'rgba(239, 68, 68, 1)'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    title: {
                        display: true,
                        text: `Key Response Time Metrics in Milliseconds (N=${logCount})`
                    },
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Response Time (ms)'
                        }
                    }
                }
            }
        };
        
        // Initialize Chart.js - Removed DOMContentLoaded wrapper
        const ctx = document.getElementById('responseTimeChart').getContext('2d');
        new Chart(ctx, chartConfig);
            
        // Critical step for Puppeteer: Signal that all asynchronous rendering is complete
        window.renderComplete = true; 
    </script>
</body>
</html>