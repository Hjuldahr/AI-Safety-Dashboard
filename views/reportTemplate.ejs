<%
// ===============================================
// === UTILITY & HELPER FUNCTIONS ================
// ===============================================

// Helper to format dates cleanly
const formatDisplayDate = (dateString) => {
    if (!dateString) return 'N/A';
    try {
        const dateObj = new Date(dateString);
        return `${String(dateObj.getUTCMonth() + 1).padStart(2, '0')}/${String(dateObj.getUTCDate()).padStart(2, '0')}/${dateObj.getUTCFullYear()}`;
    } catch(e) { return dateString; }
};

// --- EJS MACRO: Renders the Deep Dive Alerts logic for Min/Max ---
const renderDeepDive = (title, logId, sourceModel, alerts) => {
    if (!logId) return '';
    
    const alertEmojis = { critical: '🚫', high: '⚠️', medium: '🔔', info: 'ℹ️' };

    // Mapping levels to specific colors (Border and Text)
    const alertStyles = {
        critical: { border: '#ef4444', text: '#b91c1c', bg: '#fef2f2' }, // Red
        high:     { border: '#f97316', text: '#c2410c', bg: '#fff7ed' }, // Orange
        medium:   { border: '#eab308', text: '#a16207', bg: '#fefce8' }, // Yellow/Gold
        info:     { border: '#3b82f6', text: '#1d4ed8', bg: '#eff6ff' }  // Blue
    };
    
    const routePrefix = sourceModel === 'AI_Log' ? 'ai' : 'summary';
    const logUrl = `${process.env.PUBLIC_URL || ''}logs/view/${routePrefix}/${logId}`;
    
    let html = `
        <div class="trigger-section">
            <div class="trigger-header">${title} Trigger Log</div>
            <a href="${logUrl}" class="log-link">📄 View Origin Log (${sourceModel})</a>
            <div class="trigger-header" style="margin-top: 15px;">Associated Alerts</div>
    `;

    if (!alerts || alerts.length === 0) {
        html += `<div class="no-alerts">✅ No alerts triggered by this log.</div>`;
    } else {
        html += `<ul class="alerts-list">`;
        const displayAlerts = alerts.slice(0, 5);
        
        displayAlerts.forEach(a => {
            const level = a.alertLevel.toLowerCase();
            const alertUrl = `${process.env.PUBLIC_URL || ''}alerts/view/${a.alertLogId}`;
            const emoji = alertEmojis[level] || '🚨';
            const style = alertStyles[level] || { border: '#6b7280', text: '#374151', bg: '#f3f4f6' };
            
            // Applying inline styles for the PDF engine
            html += `
                <li class="alert-item" style="border-left: 4px solid ${style.border}; background-color: ${style.bg}; margin-bottom: 5px; padding: 8px; border-radius: 4px;">
                    <a href="${alertUrl}" style="color: ${style.text}; text-decoration: none;">
                        ${emoji} <strong>${a.alertLevel.toUpperCase()}:</strong> ${a.alertName}
                    </a>
                </li>`;
        });
        html += `</ul>`;

        if (alerts.length > 5) {
            const searchUrl = `${process.env.PUBLIC_URL || ''}alerts?search=${logId}`;
            html += `
                <div class="alert-overflow">
                    ⚠️ ${alerts.length - 5} additional alerts omitted for space. 
                    <a href="${searchUrl}">Click here to view full alert history for this log.</a>
                </div>`;
        }
    }
    
    html += `</div>`;
    return html;
};

const formatValue = (val) => {
    if (val === null || val === undefined || isNaN(val)) return 'N/A';
    
    const num = Number(val);

    // 1. Handle very small decimals (e.g., safety probabilities)
    if (num > 0 && num < 0.01) {
        return num.toPrecision(3); // Shows something like 0.000452
    }

    // 2. Handle standard decimals
    if (num % 1 !== 0) {
        return num.toLocaleString('en-US', { 
            minimumFractionDigits: 2, 
            maximumFractionDigits: 2 
        });
    }

    // 3. Handle large integers (adds commas: 1,250,000)
    return num.toLocaleString('en-US');
};
%>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title><%= reportTitle %></title>
  <link rel="stylesheet" href="<%= process.env.PUBLIC_URL || '' %>css/components/reportTemplate.css">
</head>

<body>
  <div class="report-container">

    <header>
      <h1><%= reportTitle %></h1>
      <h1>The PUBLIC URL is set to: <%= process.env.PUBLIC_URL%></h1>
      <p class="text-center text-muted">Log Analysis Report for Model: <strong><%= modelName %></strong></p>
    </header>

    <% if (fidelity === 'high') { %>
    <div class="fidelity-badge fidelity-high">
      🟢 <strong>High Fidelity Report:</strong> Built using raw AI Logs (1-second resolution). Includes full trace links and flagged output appendix.
    </div>
    <% } else if (fidelity === 'low') { %>
    <div class="fidelity-badge fidelity-low">
      🟡 <strong>Summary Report:</strong> Built using AI Summaries (1-minute aggregated resolution).
    </div>
    <% } else if (fidelity === 'split') { %>
    <div class="fidelity-badge fidelity-split">
      🟠 <strong>Split Fidelity Report:</strong> This timeframe spans across your data retention cutoff. Older data uses 1-minute summaries, while recent data uses 1-second raw logs.
    </div>
    <% } %>

    <div class="context-box">
      <h2>Report Context</h2>
      <div class="context-grid">
        <div><strong>Start Date:</strong> <%= formatDisplayDate(startDate) %></div>
        <div><strong>End Date:</strong> <%= formatDisplayDate(endDate) %></div>
        <div><strong>Model Analyzed:</strong> <%= modelName %></div>
        <div>
          <strong>Total Logs Counted:</strong> <%= totalLogs.toLocaleString() %>
          <% if (fidelity === 'split') { %>
          <div style="font-size: 0.85rem; color: #6b7280; margin-top: 4px;">
            (<%= highLogs.toLocaleString() %> AI Logs, <%= lowLogs.toLocaleString() %> AI Summaries)
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Table of Contents -->
    <div class="toc-box">
      <h2>Table of Contents</h2>
      <ul class="toc-list">
        <% selectedFields.forEach(function(field) {
          const statData = stats[field];
          if (!statData) return;
        %>
        <li><a href="#field-<%= field %>"><%= statData.label %></a></li>
        <% }); %>
        <% if (appendixData && appendixData.length > 0) { %>
        <li><a href="#appendix-flagged">Appendix: Raw Flagged Outputs</a></li>
        <% } %>
        <% if (aiLogsAppendix && aiLogsAppendix.length > 0) { %>
        <li><a href="#appendix-ai-logs">Appendix: AI Logs</a></li>
        <% } %>
        <% if (aiSummariesAppendix && aiSummariesAppendix.length > 0) { %>
        <li><a href="#appendix-ai-summaries">Appendix: AI Summaries</a></li>
        <% } %>
        <% if (userLogsAppendix && userLogsAppendix.length > 0) { %>
        <li><a href="#appendix-user-logs">Appendix: User Logs</a></li>
        <% } %>
        <% if (alertLogsAppendix && alertLogsAppendix.length > 0) { %>
        <li><a href="#appendix-alert-logs">Appendix: Alert Logs</a></li>
        <% } %>
      </ul>
    </div>

    <% selectedFields.forEach(function(field) {
            const statData = stats[field];
            // Skip rendering if data is missing or it's a non-numeric field that slipped through
            if (!statData) return;
        %>
    <div class="page-break"></div>

    <h2 id="field-<%= field %>"><%= statData.label %></h2>
    <% if (chartImages && chartImages[field]) { %>
    <div class="chart-container">
      <img src="<%= chartImages[field] %>" alt="<%= statData.label %> Chart" />
    </div>
    <% } %>

    <div class="kpi-grid">
      <div class="kpi-card" style="border-left-color: #10b981;">
        <p class="kpi-card-title">Minimum</p>
        <p class="kpi-card-value"><%= formatValue(statData.min) %> <span class="kpi-unit"></span></p>
      </div>
      <div class="kpi-card" style="border-left-color: <%= statData.color %>;">
        <p class="kpi-card-title">Average</p>
        <p class="kpi-card-value"><%= formatValue(statData.avg) %> <span class="kpi-unit"></span></p>
      </div>
      <div class="kpi-card" style="border-left-color: #ef4444;">
        <p class="kpi-card-title">Maximum</p>
        <p class="kpi-card-value"><%= formatValue(statData.max) %> <span class="kpi-unit"></span></p>
      </div>
    </div>

    <div class="deep-dive-grid">
      <%- renderDeepDive('Minimum', statData.minLogId, statData.minSourceModel, statData.minAlerts) %>
      <%- renderDeepDive('Maximum', statData.maxLogId, statData.maxSourceModel, statData.maxAlerts) %>
    </div>

    <% }); %>
    <%
    // Helper for alert level styling
    const alertEmojis = { critical: '🚫', high: '⚠️', medium: '🔔', info: 'ℹ️' };
    const alertStyles = {
        critical: { border: '#ef4444', text: '#b91c1c', bg: '#fef2f2' },
        high:     { border: '#f97316', text: '#c2410c', bg: '#fff7ed' },
        medium:   { border: '#eab308', text: '#a16207', bg: '#fefce8' },
        info:     { border: '#3b82f6', text: '#1d4ed8', bg: '#eff6ff' }
    };
    %>

    <% if (appendixData && appendixData.length > 0) { %>
    <div class="page-break"></div>
    <h2 id="appendix-flagged">Appendix: Raw Flagged Outputs</h2>
    <p class="text-muted" style="margin-bottom: 20px;">
      The following outputs were flagged by the AI safety system during this report's timeframe.
      <em>Note: This data is only available for the high-fidelity portion of this report.</em>
    </p>

    <% appendixData.forEach(function(flaggedObj) {
                const sevClass = flaggedObj.severity === 'severe' ? 'sev-severe' :
                                 flaggedObj.severity === 'moderate' ? 'sev-moderate' : 'sev-mild';
            %>
    <div class="appendix-card">
      <span class="severity-badge <%= sevClass %>"><%= flaggedObj.severity %></span>
      <div style="margin-bottom: 8px; font-size: 0.85rem; color: #6b7280;">
        Triggered on: <%= new Date(flaggedObj.timestamp).toLocaleString() %>
      </div>
      <div class="appendix-text"><%= flaggedObj.text %></div>
    </div>
    <% }); %>
    <% } %>

    <% if (aiLogsAppendix && aiLogsAppendix.length > 0) { %>
    <div class="page-break"></div>
    <h2 id="appendix-ai-logs">Appendix: AI Logs</h2>
    <p class="text-muted" style="margin-bottom: 20px;">
      High-fidelity AI log entries recorded during this report's timeframe.
      Showing up to 200 most recent entries.
    </p>

    <% aiLogsAppendix.forEach(function(log) { %>
    <div class="appendix-card appendix-log-card">
      <div class="appendix-log-header">
        <span class="appendix-log-model"><%= log.modelName %></span>
        <span class="appendix-log-time"><%= new Date(log.responseTimestamp).toLocaleString() %></span>
      </div>
      <div class="appendix-log-stats">
        <% if (log.policyCompliance !== undefined) { %>
          <span>Policy: <%= (log.policyCompliance ?? 0).toFixed(1) %>%</span>
        <% } %>
        <% if (log.responseTime !== undefined) { %>
          <span>Response: <%= (log.responseTime ?? 0).toFixed(0) %>ms</span>
        <% } %>
        <% if (log.tokensUsed !== undefined) { %>
          <span>Tokens: <%= (log.tokensUsed ?? 0).toLocaleString() %></span>
        <% } %>
        <% if (log.flaggedCount > 0) { %>
          <span class="appendix-flagged-count">⚠️ <%= log.flaggedCount %> flagged</span>
        <% } %>
      </div>
      <a href="<%= process.env.PUBLIC_URL || '' %>logs/view/ai/<%= log._id %>" class="appendix-log-link">📄 View Full Log</a>
    </div>
    <% }); %>
    <% } %>

    <% if (aiSummariesAppendix && aiSummariesAppendix.length > 0) { %>
    <div class="page-break"></div>
    <h2 id="appendix-ai-summaries">Appendix: AI Summaries</h2>
    <p class="text-muted" style="margin-bottom: 20px;">
      1-minute aggregated AI summaries recorded during this report's timeframe.
      Showing up to 200 most recent entries.
    </p>

    <% aiSummariesAppendix.forEach(function(summary) { %>
    <div class="appendix-card appendix-log-card">
      <div class="appendix-log-header">
        <span class="appendix-log-model"><%= summary.modelName %></span>
        <span class="appendix-log-time"><%= new Date(summary.responseTimestamp).toLocaleString() %></span>
      </div>
      <div class="appendix-log-stats">
        <% if (summary.policyCompliance !== undefined) { %>
          <span>Policy: <%= (summary.policyCompliance ?? 0).toFixed(1) %>%</span>
        <% } %>
        <% if (summary.responseTime !== undefined) { %>
          <span>Response: <%= (summary.responseTime ?? 0).toFixed(0) %>ms</span>
        <% } %>
        <% if (summary.tokensUsed !== undefined) { %>
          <span>Tokens: <%= (summary.tokensUsed ?? 0).toLocaleString() %></span>
        <% } %>
        <% if (summary.queryCount !== undefined) { %>
          <span>Queries: <%= (summary.queryCount ?? 0).toLocaleString() %></span>
        <% } %>
      </div>
      <!-- ToDo: Add deep link to AI Summary view once summary deep linking is implemented -->
    </div>
    <% }); %>
    <% } %>

    <% if (userLogsAppendix && userLogsAppendix.length > 0) { %>
    <div class="page-break"></div>
    <h2 id="appendix-user-logs">Appendix: User Logs</h2>
    <p class="text-muted" style="margin-bottom: 20px;">
      User activity recorded during this report's timeframe.
      Showing up to 200 most recent entries.
    </p>

    <% userLogsAppendix.forEach(function(ulog) { %>
    <div class="appendix-card appendix-log-card">
      <div class="appendix-log-header">
        <span class="appendix-log-model"><%= ulog.userID?.username || 'Unknown User' %></span>
        <span class="appendix-event-badge"><%= ulog.eventType %></span>
        <span class="appendix-log-time"><%= new Date(ulog.createdAt).toLocaleString() %></span>
      </div>
      <div class="appendix-log-details"><%= ulog.details %></div>
    </div>
    <% }); %>
    <% } %>

    <% if (alertLogsAppendix && alertLogsAppendix.length > 0) { %>
    <div class="page-break"></div>
    <h2 id="appendix-alert-logs">Appendix: Alert Logs</h2>
    <p class="text-muted" style="margin-bottom: 20px;">
      Alerts triggered during this report's timeframe.
      Showing up to 200 most recent entries.
    </p>

    <% alertLogsAppendix.forEach(function(alog) {
      const level = (alog.alertSnapshot?.alertLevel || 'info').toLowerCase();
      const style = alertStyles[level] || alertStyles.info;
      const emoji = alertEmojis[level] || '🚨';
    %>
    <div class="appendix-card appendix-alert-card" style="border-left: 4px solid <%= style.border %>; background-color: <%= style.bg %>;">
      <div class="appendix-log-header">
        <span style="color: <%= style.text %>; font-weight: 700;">
          <%= emoji %> <%= (alog.alertSnapshot?.alertLevel || 'INFO').toUpperCase() %>
        </span>
        <span class="appendix-log-time"><%= new Date(alog.timestamp).toLocaleString() %></span>
      </div>
      <div class="appendix-alert-name"><%= alog.alertSnapshot?.alertName || 'Unknown Alert' %></div>
      <a href="<%= process.env.PUBLIC_URL || '' %>alerts/view/<%= alog._id %>" class="appendix-log-link" style="color: <%= style.text %>;">🔔 View Alert Details</a>
    </div>
    <% }); %>
    <% } %>

  </div>
</body>

</html>